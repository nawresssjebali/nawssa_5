# Stage 1: Build Angular app
FROM node:20-bullseye AS build

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Install RxJS and Angular CLI
RUN npm install rxjs --legacy-peer-deps
RUN npm install -g @angular/cli@19.2.4

# Copy source code
COPY . .

# Avoid memory issues
ENV NODE_OPTIONS=--max_old_space_size=4096

# Build Angular app
RUN ng build projet_pfe_nawress_jebali --configuration production

# Verify build exists
RUN if [ ! -d /app/dist/projet_pfe_nawress_jebali ]; then echo "Build failed!"; exit 1; fi

# Stage 2: Serve the Angular app with Nginx
FROM nginx:alpine

# Copy built app contents directly (no trailing dot)
COPY --from=build /app/dist/projet_pfe_nawress_jebali /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

