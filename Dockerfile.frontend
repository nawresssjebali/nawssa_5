# Stage 1: Build Angular app (using full Debian image)
FROM node:20-bullseye AS build

WORKDIR /app

# Install system dependencies for building native modules
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package.json and package-lock.json first for caching
COPY package*.json ./

# Install dependencies (handle peer deps)
RUN npm install --legacy-peer-deps

# Install Angular CLI globally
RUN npm install -g @angular/cli@latest

# Copy rest of the application code
COPY . .

# Increase Node memory limit to avoid build crashes
ENV NODE_OPTIONS=--max_old_space_size=4096

# Build Angular app (production mode)
RUN ng build --configuration=production

# Stage 2: Use Nginx to serve app
FROM nginx:alpine

# Copy built Angular app from Stage 1
COPY --from=build /app/dist/aftas-angular /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

