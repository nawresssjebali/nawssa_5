# Stage 1: Build Angular app (client + server)
FROM node:20-bullseye AS build

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package.json for caching
COPY package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps
RUN npm install rxjs --legacy-peer-deps
RUN npm install -g @angular/cli@latest typescript

# Copy the rest of the code
COPY . .

# Increase Node memory
ENV NODE_OPTIONS=--max_old_space_size=4096

# Build Angular app (client + server)
RUN ng build --configuration=production
RUN ng run projet_pfe_nawress_jebali:server:production

# Create temporary tsconfig for server.ts compilation
RUN echo '{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/src"
  },
  "include": ["src/server.ts"]
}' > tsconfig.server.json

# Compile server.ts to JavaScript
RUN npx tsc -p tsconfig.server.json

# Stage 2: Run Angular Universal server
FROM node:20-bullseye

WORKDIR /app

# Copy Angular build
COPY --from=build /app/dist/projet_pfe_nawress_jebali /app/dist/projet_pfe_nawress_jebali
# Copy compiled server.js
COPY --from=build /app/dist/src/server.js /app/dist/src/server.js
# Copy package.json
COPY package*.json ./

# Install only production dependencies
RUN npm install --legacy-peer-deps --omit=dev

# Expose the port
EXPOSE 4000

# Run the server
CMD ["node", "dist/src/server.js"]

