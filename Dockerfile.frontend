# Stage 1: Build Angular app
FROM node:20-bullseye AS build

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Explicitly install RxJS
RUN npm install rxjs --legacy-peer-deps

# Install Angular CLI
RUN npm install -g @angular/cli@19.2.4

# Copy source code
COPY . .

# Avoid memory issues
ENV NODE_OPTIONS=--max_old_space_size=4096

# Build browser app
RUN ng build projet_pfe_nawress_jebali --configuration production

# Optional: debug build stage
RUN ls -la /app/dist/projet_pfe_nawress_jebali

# Stage 2: Serve the Angular app with nginx
FROM nginx:alpine

# Ensure html folder exists
RUN mkdir -p /usr/share/nginx/html

# Copy built Angular app contents safely (all files, not folder)
COPY --from=build /app/dist/projet_pfe_nawress_jebali/. /usr/share/nginx/html/

# Optional: debug copied files
RUN ls -la /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
