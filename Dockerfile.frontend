# Stage 1: Build Angular app + compile server.ts
FROM node:20-bullseye AS build
WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

# Copy package.json and install deps
COPY package*.json ./
RUN npm install --legacy-peer-deps
RUN npm install -g @angular/cli@latest typescript

# Copy source code
COPY . .

# Increase Node memory
ENV NODE_OPTIONS=--max_old_space_size=4096

# Build Angular client and server
RUN ng build --configuration=production
RUN ng run projet_pfe_nawress_jebali:server:production

# Compile server.ts
RUN npx tsc src/server.ts --outDir dist

# Stage 2: Run
FROM node:20-bullseye
WORKDIR /app

# Copy built Angular server and compiled server.js
COPY --from=build /app/dist/projet_pfe_nawress_jebali /app/dist/projet_pfe_nawress_jebali
COPY --from=build /app/dist/server.js ./dist/server.js
COPY package*.json ./

# Install only production deps
RUN npm install --legacy-peer-deps --omit=dev

EXPOSE 4000

# Run Express SSR server
CMD ["node", "dist/server.js"]
