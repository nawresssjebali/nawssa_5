# Stage 1: Build Angular app (client + server)
FROM node:20-bullseye AS build

WORKDIR /app

RUN apt-get update && apt-get install -y python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install --legacy-peer-deps
RUN npm install rxjs --legacy-peer-deps
RUN npm install -g @angular/cli@19.2.4

# Ensure Universal dependencies are installed
RUN npm install @nguniversal/express-engine@19.0.0-rc.1 --legacy-peer-deps
RUN npm install @nguniversal/builders@19.0.0-rc.1 --legacy-peer-deps


COPY . .

ENV NODE_OPTIONS=--max_old_space_size=4096

# Build client
RUN ng build projet_pfe_nawress_jebali --configuration production

# Build server (Angular Universal)
RUN ng run projet_pfe_nawress_jebali:server:production

# Stage 2: Run Angular Universal server
FROM node:20-bullseye

WORKDIR /app

COPY --from=build /app/dist/projet_pfe_nawress_jebali /app/dist/projet_pfe_nawress_jebali
COPY --from=build /app/dist/projet_pfe_nawress_jebali-server /app/dist/projet_pfe_nawress_jebali-server
COPY package*.json ./

RUN npm install --legacy-peer-deps --omit=dev

EXPOSE 4000

CMD ["node", "dist/projet_pfe_nawress_jebali-server/main.js"]
