FROM python:3.9-slim-bookworm

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y git \
    libglib2.0-0 libsm6 libxrender1 libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Clone only the Backend folder
RUN git clone -b main --single-branch --depth 1 https://github.com/nawresssjebali/nawssa_5.git /tmp/nawssa_5 \
    && cp -r /tmp/nawssa_5/Backend/. /app/ \
    && rm -rf /tmp/nawssa_5


# Install Python dependencies
RUN pip install --upgrade pip \
    && pip install --no-cache-dir flask flask-cors gunicorn requests opencv-python

# Expose port
EXPOSE 3000

# Run Gunicorn pointing to app.py
CMD ["gunicorn", "-b", "0.0.0.0:3000", "app:app"]
