FROM pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    git libglib2.0-0 libsm6 libxrender1 libxext6 libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Clone repo
RUN git clone -b main --single-branch --depth 1 https://github.com/nawresssjebali/nawssa_5.git /tmp/nawssa_5 \
    && sh -c 'mv /tmp/nawssa_5/Backend/* /app/ 2>/dev/null || true' \
    && sh -c 'mv /tmp/nawssa_5/Backend/.* /app/ 2>/dev/null || true' \
    && rm -rf /tmp/nawssa_5

# Copy requirements file from Backend
COPY Backend/requirements.txt /app/requirements.txt

# Upgrade pip and install all Python dependencies
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

EXPOSE 3000

CMD ["gunicorn", "-b", "0.0.0.0:3000", "app:app"]
