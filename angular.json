{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "projet_pfe_nawress_jebali": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/projet_pfe_nawress_jebali",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "assets" }
            ],
            "styles": [
              "src/styles.css",
              "node_modules/ngx-toastr/toastr.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/projet_pfe_nawress_jebali-server",
            "main": "src/main.server.ts",
            "tsConfig": "tsconfig.server.json",
            "clientProject": "projet_pfe_nawress_jebali"
          },
          "configurations": {
            "production": { "optimization": true, "sourceMap": false },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "projet_pfe_nawress_jebali:build:production"
            },
            "development": {
              "buildTarget": "projet_pfe_nawress_jebali:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              { "glob": "**/*", "input": "src/assets" }
            ],
            "styles": ["src/styles.css"],
            "scripts": []
          }
        },
        "prerender": {
          "builder": "@nguniversal/builders:prerender",
          "options": {
            "browserTarget": "projet_pfe_nawress_jebali:build:production",
            "serverTarget": "projet_pfe_nawress_jebali:server:production",
            "routes": ["/", "/login", "/dashboard"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "b03f8491-8da7-4c52-a26c-c1fc042db9bc"
  }
}
